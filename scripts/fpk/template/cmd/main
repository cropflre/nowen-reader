#!/bin/bash

case "${1:-}" in
  start)
    # Re-render docker-compose.yaml from template with current TRIM_DATA_ACCESSIBLE_PATHS.
    bash "$(dirname "$0")/render_compose" || exit 1
    # fnOS App Center owns the Docker project lifecycle.
    exit 0
    ;;
  stop)
    # fnOS App Center owns the Docker project lifecycle.
    exit 0
    ;;
  status)
    if [ "$(docker inspect --format '{{.State.Running}}' nowen-reader 2>/dev/null)" = "true" ]; then
      exit 0
    fi
    exit 3
    ;;
  *)
    exit 1
    ;;
esac
