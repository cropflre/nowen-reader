#!/bin/bash
set -eu
# Create nested cache directories as the package user before Docker starts.
# The image initializes only the cache root ownership on its auto fast path.
: "${TRIM_PKGVAR:?fnOS application data directory is required}"
mkdir -p "${TRIM_PKGVAR}/data" "${TRIM_PKGVAR}/cache/thumbnails" "${TRIM_PKGVAR}/cache/pages"
